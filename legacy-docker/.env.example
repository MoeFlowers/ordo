# ==========================================================
#  Configuracion de Control de Deudas
#  Copia este archivo como  .env  y rellena tus datos.
# ==========================================================

# --- Correo (Gmail) ---
# 1) Activa la verificacion en 2 pasos en tu cuenta de Google.
# 2) Crea una "Contrasena de aplicacion" en:
#    https://myaccount.google.com/apppasswords
# 3) Pega esa contrasena de 16 letras aqui (sin espacios).
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=pon_aqui_tu_contrasena_de_aplicacion

# A que correo te llegan los avisos (por defecto, el tuyo)
NOTIFY_EMAIL=tu-correo@gmail.com

# Avisar cuando falten estos dias (o menos) para el vencimiento
REMINDER_DAYS=3

# --- API de tasas (no necesitas cambiar esto) ---
RATES_API=https://ve.dolarapi.com/v1/dolares
